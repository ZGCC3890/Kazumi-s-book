{
  "version": 1,
  "type": "novel-xpath",
  "id": "lightnovel",
  "name": "LightNovel（中文译文）",
  "revision": "2026-10-17.1",
  "language": "zh",
  "edition": "中文译文（切源时核验译本）",
  "encoding": "utf-8",
  "requestEncoding": "json",
  "headers": {"Referer": "https://www.lightnovel.fun/", "User-Agent": "KazumisBook/0.1.0", "Accept-Encoding": "identity"},
  "loginRequiredUrlPattern": "",
  "loginRequiredXPath": "",
  "searchFormat": "html",
  "searchMethod": "GET",
  "searchUrl": "https://www.lightnovel.fun/search?keyword=@keyword&page=1",
  "searchBody": {},
  "directBookUrlPattern": "^https://www\\.lightnovel\\.fun/book/[0-9]+$",
  "search": {
    "singleDetect": "",
    "singleTitle": "//div[@class='detail-info']/h1",
    "singleAuthor": "//div[@class='detail-info-line']/span[1]/strong",
    "singleAuthorRegex": "^(.+)$",
    "singleCover": "//span[contains(@class,'detail-cover')]/img",
    "itemsMode": "css", "items": "a.search-book-link",
    "title": ".//h2", "titleAttribute": "",
    "link": ".", "linkAttribute": "href",
    "author": ".//div[@class='search-book-meta']/span[1]",
    "authorRegex": "^作者[：:]\\s*(.*)",
    "cover": ".//img", "coverAttribute": "src"
  },
  "catalog": {
    "mode": "json-volumes",
    "bookIdPattern": "/book/([0-9]+)$",
    "volumesUrl": "https://www.lightnovel.fun/api/pc-proxy/api/new-content-read/get-book-volumes",
    "volumesBody": "{\"book_id\":\"@book\",\"page\":\"@page\",\"pageSize\":\"50\",\"page_size\":\"50\"}",
    "chaptersUrl": "https://www.lightnovel.fun/api/pc-proxy/api/new-content-read/get-volume-chapters",
    "chaptersBody": "{\"book_id\":\"@book\",\"volume_id\":\"@volume\",\"page\":\"@page\",\"pageSize\":\"50\",\"page_size\":\"50\"}",
    "itemsPath": "$.data.list[*]",
    "hasNextPath": "$.data.page_info.has_next",
    "volumeIdPath": "$.volume_id",
    "volumeTitlePath": "$.title",
    "volumeCountPath": "$.chapter_count",
    "chapterIdPath": "$.chapter_id",
    "chapterTitlePath": "$.title",
    "chapterUrl": "https://www.lightnovel.fun/reader/@book/@chapter",
    "nodes": ".chapter-grid a.chapter",
    "volumeClass": "volume-title",
    "detailToCatalog": "",
    "title": ".", "link": ".", "linkAttribute": "href",
    "next": "", "nextAttribute": "href"
  },
  "content": {
    "format": "json-html",
    "chapterIdPattern": "/reader/([0-9]+)/([0-9]+)$",
    "url": "https://www.lightnovel.fun/api/pc-proxy/api/new-content-read/get-chapter-detail",
    "body": "{\"book_id\":\"@book\",\"chapter_id\":\"@chapter\"}",
    "lockedPath": "$.data.locked",
    "htmlPath": "$.data.render_preview.body_html",
    "root": "//body",
    "remove": "//script | //style",
    "imageAttribute": "src",
    "next": "", "nextAttribute": "href"
  }
}
